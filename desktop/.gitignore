# Node
node_modules/

# Local env / pilot secrets (never commit)
.env
.env.*
!.env.example
!.env.production.example
.env.production.local
.env*.local

# Vite build output
dist/

# Stream D staged release artifacts (installers + checksums — local only)
dist-release/

# Signing / minisign private material (never commit)
# Keep MINISIGN_SECRET_KEY outside the repo (e.g. %USERPROFILE%\.secrets\minisign.key)
*.pfx
*.p12
*.key
!*.pub
minisign.key
**/minisign.key
*.minisign.key
minisign.*.key

# Tauri build output (already covered by the repo-root **/target/ rule; kept local for clarity)
src-tauri/target/

# Tauri-generated capability/ACL schema files (editor autocompletion only, regenerated on build)
src-tauri/gen/schemas/
