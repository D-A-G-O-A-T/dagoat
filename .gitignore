# .gitignore -- GoatCoin
#
# Build output and local runtime state only. Every rule below names something a
# clone PRODUCES by building or running this repository. Nothing here names a
# file anyone is expected to author, and nothing here is a substitute for not
# committing a file in the first place.
#
# Scoped rules live next to what they cover and remain the authority there:
#
#   contracts/.gitignore            Foundry out/, cache/, broadcast/, and the
#                                   per-run scratch deploy directories
#   desktop/.gitignore              node_modules/, Vite dist/, dist-release/,
#                                   Tauri src-tauri/target and gen/schemas
#   tools/goat-attestor/.gitignore  daemon state/, evidence/, registry.json,
#                                   relayer logs, gate logs
#
# The rules here are the repo-wide floor, so a crate or package added tomorrow
# is covered on the day it is added rather than the day someone remembers.

# -- Rust / Cargo -------------------------------------------------------------
# No leading slash: this matches target/ at every depth, which is what the
# workspace root, goatcoin-rs/, tools/goat-attestor/ and desktop/src-tauri/ all
# need. Cargo.lock is committed on purpose (this repo ships binaries) and is
# deliberately NOT ignored.
target/
**/*.rs.bk

# -- Node / JavaScript --------------------------------------------------------
node_modules/
dist/
dist-release/
build/

# -- Foundry ------------------------------------------------------------------
out/
cache/
broadcast/
# Per-test epoch manifests. `forge test` runs a contract's test functions
# concurrently, so DeployEpochSettlement gives each test its own file rather
# than racing on the committed deployments/<chainid>.epoch.json -- vm.writeJson
# truncates before it writes. See contracts/test/DeployEpochSettlement.t.sol.
contracts/deployments/*.epoch.t-*.json

# -- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# -- Local dev-chain and launcher state ---------------------------------------
# Written by desktop/GOAT-START.bat and desktop/start-app.ps1 when you run the
# local anvil chain and the Vite dev server.
desktop/.run-logs/
desktop/.anvil-state.json
# Written by the goat-net stats collector
# (goatcoin-rs/crates/goat-net/src/bin/collect.rs).
livestats.json

# -- Secrets and local environment (never commit) -----------------------------
.env
.env.*
!.env.example
keys/
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# -- Logs, scratch, merge leftovers -------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej

# -- Editor and OS detritus ---------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini
